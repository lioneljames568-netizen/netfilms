APP_NAME=NetFilms API
ENVIRONMENT=development
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000
SUPABASE_URL=https://gsgoxmcsvycmckvehowa.supabase.co
# Supabase publishable key (or legacy anon key); never use service_role here.
SUPABASE_ANON_KEY=your_supabase_publishable_key

# Cloudflare R2 — configure only in the backend environment, never in the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=netfilms-media
R2_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=2000000000
